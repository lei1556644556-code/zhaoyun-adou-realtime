# Copy client values to apps/client/.env.development.local for an isolated backend.
VITE_DEPLOY_ENV=local
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Optional standalone Socket.IO server. The current browser transport uses
# Supabase Realtime; VITE_SERVER_URL is reserved until the transport port lands.
VITE_SERVER_URL=http://localhost:3001
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
STATIC_DIR=../client/dist
